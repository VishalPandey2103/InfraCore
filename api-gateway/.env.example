PORT=3000
JWT_SECRET=change-this-to-the-same-value-as-user-service
USER_SERVICE_URL=http://localhost:4000
INVENTORY_SERVICE_URL=http://localhost:4001
BOOKING_SERVICE_URL=http://localhost:4002

# Redis (shared with user-service for JWT blacklist)
REDIS_URL=redis://localhost:6379

# Rate limits: per-user for protected routes, per-IP for auth routes.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
