PORT=4003
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_EXCHANGE=infracore.events
RABBITMQ_QUEUE=notification.bookings

# Dead-letter / retry topology
RABBITMQ_RETRY_EXCHANGE=infracore.retry
RABBITMQ_RETRY_QUEUE=notification.bookings.retry
RABBITMQ_PARKING_QUEUE=notification.bookings.parking

# Retry policy: exponential backoff = BASE * 2^attempt
# 5000 -> attempt1=5s, attempt2=10s, attempt3=20s
RETRY_BASE_DELAY_MS=5000
MAX_RETRIES=3

# Admin API secret for /admin routes (peek / replay / purge parking queue)
ADMIN_API_SECRET=change-me-to-something-strong

# Set > 0 to inject synthetic failures for demoing the retry pipeline (0-1)
FORCE_FAILURE_RATE=0
