PORT=4001
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/inventory-service
# Shared secret for service-to-service calls (must match booking-service)
INTERNAL_API_SECRET=<random-long-string>

# Redis for read cache
REDIS_URL=redis://localhost:6379
CACHE_ITEM_TTL_SECONDS=300
CACHE_LIST_TTL_SECONDS=60
