# This file documents env vars used across services.
# Each service reads its OWN .env file (in its own folder).
# Copy the relevant vars into services/<name>/.env and api-gateway/.env

# ---- User Service ----
# PORT=4000
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/user-service
# JWT_SECRET=<64-char-random-string>
# JWT_EXPIRES_IN=7d
# REDIS_URL=redis://localhost:6379

# ---- Inventory Service ----
# PORT=4001
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/inventory-service
# INTERNAL_API_SECRET=<same-as-booking-service>
# REDIS_URL=redis://localhost:6379
# CACHE_ITEM_TTL_SECONDS=300
# CACHE_LIST_TTL_SECONDS=60

# ---- Booking Service ----
# PORT=4002
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/booking-service
# INVENTORY_SERVICE_URL=http://localhost:4001
# INTERNAL_API_SECRET=<same-as-inventory-service>
# RABBITMQ_URL=amqp://localhost:5672
# RABBITMQ_EXCHANGE=infracore.events

# ---- Notification Service ----
# PORT=4003
# RABBITMQ_URL=amqp://localhost:5672
# RABBITMQ_EXCHANGE=infracore.events
# RABBITMQ_QUEUE=notification.bookings
# RABBITMQ_RETRY_EXCHANGE=infracore.retry
# RABBITMQ_RETRY_QUEUE=notification.bookings.retry
# RABBITMQ_PARKING_QUEUE=notification.bookings.parking
# RETRY_BASE_DELAY_MS=5000
# MAX_RETRIES=3
# ADMIN_API_SECRET=<random>
# FORCE_FAILURE_RATE=0

# ---- API Gateway ----
# PORT=3000
# JWT_SECRET=<same-as-user-service>
# USER_SERVICE_URL=http://localhost:4000
# INVENTORY_SERVICE_URL=http://localhost:4001
# BOOKING_SERVICE_URL=http://localhost:4002
# REDIS_URL=redis://localhost:6379
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_AUTH_WINDOW_SECONDS=60
