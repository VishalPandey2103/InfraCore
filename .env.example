# This file documents env vars used across services.
# Each service reads its OWN .env file (in its own folder).
# Copy the relevant vars into services/<name>/.env and api-gateway/.env

# ---- User Service ----
# PORT=4000
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/user-service
# JWT_SECRET=<64-char-random-string>
# JWT_EXPIRES_IN=7d

# ---- Inventory Service ----
# PORT=4001
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/inventory-service

# ---- Booking Service ----
# PORT=4002
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/booking-service
# INVENTORY_SERVICE_URL=http://localhost:4001
# RABBITMQ_URL=amqp://localhost:5672
# RABBITMQ_EXCHANGE=infracore.events

# ---- Notification Service ----
# PORT=4003
# RABBITMQ_URL=amqp://localhost:5672
# RABBITMQ_EXCHANGE=infracore.events
# RABBITMQ_QUEUE=notification.bookings

# ---- API Gateway ----
# PORT=3000
# JWT_SECRET=<same-as-user-service>
# USER_SERVICE_URL=http://localhost:4000
# INVENTORY_SERVICE_URL=http://localhost:4001
# BOOKING_SERVICE_URL=http://localhost:4002
